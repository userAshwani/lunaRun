{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Only the commands listed in build.rs are granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-jobs-list",
    "allow-job-cancel",
    "allow-runtimes-available",
    "allow-runtimes-installed",
    "allow-registry-refresh",
    "allow-runtime-install",
    "allow-runtime-uninstall",
    "allow-runtime-usage",
    "allow-services-list",
    "allow-services-leftovers",
    "allow-service-start",
    "allow-service-stop",
    "allow-service-restart",
    "allow-service-port-reassign",
    "allow-service-logs",
    "allow-service-adopt",
    "allow-service-stop-leftover"
  ]
}
