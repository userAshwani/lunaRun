{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Only the commands listed in build.rs are granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-app-info",
    "allow-jobs-list",
    "allow-job-cancel",
    "allow-runtimes-available",
    "allow-runtimes-installed",
    "allow-registry-refresh",
    "allow-runtime-install",
    "allow-runtime-uninstall",
    "allow-runtime-usage",
    "allow-services-list",
    "allow-services-leftovers",
    "allow-service-start",
    "allow-service-stop",
    "allow-service-restart",
    "allow-service-port-reassign",
    "allow-service-logs",
    "allow-service-adopt",
    "allow-service-stop-leftover",
    "allow-projects-list",
    "allow-project-get",
    "allow-project-add",
    "allow-project-detect",
    "allow-project-update",
    "allow-project-remove",
    "allow-sites-list",
    "allow-sites-sync",
    "allow-project-start",
    "allow-project-stop",
    "allow-project-open",
    "allow-project-database",
    "allow-project-env-port-preview",
    "allow-project-env-port-apply",
    "allow-project-database-status",
    "allow-project-database-create",
    "allow-onboarding-get",
    "allow-onboarding-complete",
    "allow-onboarding-check-home",
    "allow-onboarding-choose-home",
    "allow-app-restart"
  ]
}
